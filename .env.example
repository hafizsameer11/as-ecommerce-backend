NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
# customer website, used for links in emails (pay links, cart recovery, order tracking)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

DATABASE_URL=mysql://asl:asl@localhost:3306/asl
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# PAYMENT_PROVIDER=paystack needs the secret key (also used to verify webhooks: POST /api/v1/webhooks/payments/paystack)
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx
# PAYSTACK_CALLBACK_URL=https://asloriginals.com/payment/return
# production refuses the mock gateway unless this is set (demo/staging only)
# ALLOW_MOCK_PAYMENTS=false

MAIL_FROM="ASL ORIGINALS <no-reply@asloriginals.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

SMS_PROVIDER=mock
PUSH_PROVIDER=mock

# seed admin account (only used by db:seed)
SEED_ADMIN_EMAIL=admin@asloriginals.com
SEED_ADMIN_PASSWORD=ChangeMe123!
