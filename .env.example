NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
# comma separated origins allowed to call the API (asl-web, asl-admin, expo web)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

DATABASE_URL=mysql://asl:asl@localhost:3306/asl
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

MAIL_FROM="ASL ORIGINALS <no-reply@asloriginals.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

SMS_PROVIDER=mock
PUSH_PROVIDER=mock

# seed admin account (only used by db:seed)
SEED_ADMIN_EMAIL=admin@asloriginals.com
SEED_ADMIN_PASSWORD=ChangeMe123!
