/// In-store POS: registers, cash sessions, and till audit. Orders/customers/stock stay in commerce/inventory.

model PosRegister {
  id           String   @id @default(cuid())
  /// PickupLocation id (boutique)
  locationId   String
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  name         String
  device       String?  @db.VarChar(120)
  printer      String?  @db.VarChar(120)
  terminalId   String?  @db.VarChar(80)
  drawer       Boolean  @default(true)
  scanner      String?  @db.VarChar(120)
  active       Boolean  @default(true)
  online       Boolean  @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     PosRegisterSession[]

  @@index([locationId, active])
  @@index([warehouseId])
}

model PosRegisterSession {
  id              String    @id @default(cuid())
  registerId      String
  register        PosRegister @relation(fields: [registerId], references: [id])
  openedById      String
  openedAt        DateTime  @default(now())
  /// opening float in kobo
  float           Int
  closedAt        DateTime?
  closedById      String?
  /// counted cash at close (kobo)
  counted         Int?
  /// system expected cash at close (kobo)
  expected        Int?
  note            String?   @db.VarChar(500)
  moves           PosCashMove[]

  @@index([registerId, openedAt])
  @@index([openedById])
}

model PosCashMove {
  id        String   @id @default(cuid())
  sessionId String
  session   PosRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(8) // in | out
  amount    Int
  reason    String   @db.VarChar(200)
  staffId   String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

/// Outbound customer messages from the till. Providers (SMS/WhatsApp/email) are wired in Phase 5.
model PosOutboundMessage {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// email | sms | whatsapp | push
  channel    String   @db.VarChar(16)
  /// pos.receipt | pos.gift_receipt | pos.return_slip | pickup.ready | …
  template   String   @db.VarChar(64)
  to         String   @db.VarChar(190)
  /// pending | sent | failed (providers flip pending → sent later)
  status     String   @db.VarChar(16) @default("pending")
  orderId    String?
  returnId   String?
  bookingId  String?
  staffId    String?
  payload    Json
  error      String?  @db.Text
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([template, createdAt])
}

/// Till actions that need a supervisor/manager trail (also mirrored to platform AuditLog where useful).
model PosAuditEvent {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  locationId   String?
  registerId   String?
  sessionId    String?
  staffId      String
  approvedById String?
  /// discount | price | refund | void | cash | drawer | stock | sale | sync
  action       String   @db.VarChar(32)
  text         String   @db.Text
  amount       Int?
  ref          String?  @db.VarChar(64)

  @@index([at])
  @@index([registerId, at])
  @@index([staffId, at])
}

model GiftCard {
  id         String   @id @default(cuid())
  code       String   @unique @db.VarChar(32)
  /// kobo
  initial    Int
  balance    Int
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  status     String   @db.VarChar(16) @default("active") // active | used | cancelled
  locationId String?
  customerId String?
  orderId    String?
  events     GiftCardEvent[]

  @@index([status])
  @@index([customerId])
}

model GiftCardEvent {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  /// issued | redeemed | refunded | adjusted | cancelled
  kind       String   @db.VarChar(16)
  amount     Int
  ref        String?  @db.VarChar(64)
  staffId    String?

  @@index([giftCardId, at])
}

model PosPromotion {
  id        String   @id @default(cuid())
  name      String
  label     String
  /// bxgy | percent | spend | birthday
  kind      String   @db.VarChar(16)
  buy       Int?
  get       Int?
  /// percent points, or kobo for spend
  value     Int
  minSpend  Int?
  /// { type: all|category|brand, value?: string }
  scope     Json
  /// ["pos","web","app"]
  channels  Json
  /// pickup location ids; empty = all
  stores    Json
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model PosAlteration {
  id           String    @id @default(cuid())
  number       String    @unique
  customerId   String?
  customerName String
  phone        String    @db.VarChar(30)
  orderNumber  String?
  item         String
  work         Json
  notes        String?   @db.Text
  fee          Int       @default(0)
  locationId   String
  staffId      String
  tailor       String
  createdAt    DateTime  @default(now())
  readyBy      DateTime
  /// received | with-tailor | ready | collected
  status       String    @db.VarChar(16) @default("received")
  collectedAt  DateTime?

  @@index([locationId, status])
  @@index([status, readyBy])
}

model PosStockTransfer {
  id           String   @id @default(cuid())
  number       String   @unique
  createdAt    DateTime @default(now())
  fromWarehouseId String
  toWarehouseId   String
  variantId    String
  qty          Int
  /// requested | approved | in-transit | received | rejected
  status       String   @db.VarChar(16) @default("requested")
  requestedById String
  reason       String?  @db.VarChar(300)
  /// [{ status, at, by }]
  steps        Json

  @@index([status, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model PosStockCount {
  id          String   @id @default(cuid())
  number      String   @unique
  warehouseId String
  at          DateTime @default(now())
  staffId     String
  approvedById String?
  scope       String   @db.VarChar(120)
  /// [{ variantId, expected, counted }]
  lines       Json
  /// open | posted
  status      String   @db.VarChar(16) @default("open")

  @@index([warehouseId, at])
}

model PosGoodsReceipt {
  id          String    @id @default(cuid())
  number      String    @unique
  supplier    String
  warehouseId String
  expectedAt  DateTime
  /// [{ variantId, qty, received }]
  lines       Json
  /// expected | partial | received
  status      String    @db.VarChar(16) @default("expected")
  receivedAt  DateTime?
  receivedById String?

  @@index([warehouseId, status])
}

/// Layaway / reserve-with-deposit linked to a store Order
model PosLayaway {
  id        String    @id @default(cuid())
  orderId   String    @unique
  deposit   Int
  balance   Int
  until     DateTime
  /// open | paid | cancelled
  status    String    @db.VarChar(16) @default("open")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, until])
}
